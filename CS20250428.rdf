  <rdf:Description rdf:about="CS20250428_GROUP_0015">
    <CAS:has_labelset rdf:resource="Group"/>
    <rdfs:label>GPi Core</rdfs:label>
    <CAS:cell_ontology_term>internal globus pallidus core projecting neuron</CAS:cell_ontology_term>
    <CAS:rationale>Mapping to the general GPi core cell type is based on location (to GPi, nested inside GPi shell neurons), predicted neurotransmitter (GABA), and expression of Pvalb.</CAS:rationale>
    <CAS:rationale_dois>https://doi.org/10.1016/j.neuron.2017.03.017</CAS:rationale_dois>
    <CAS:rationale_dois>https://doi.org/10.1523/ENEURO.0208-22.2022</CAS:rationale_dois>
    <CAS:marker_gene_evidence>Pvalb</CAS:marker_gene_evidence>
    <CAS:synonyms>GPi Core</CAS:synonyms>
