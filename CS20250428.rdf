  <rdf:Description rdf:about="CS20250428_GROUP_0013">
    <CAS:has_labelset rdf:resource="Group"/>
    <rdfs:label>GPe MEIS2-SOX6 GABA</rdfs:label>
    <CAS:cell_ontology_term>arkypallidal neuron</CAS:cell_ontology_term>
    <CAS:rationale>Mapping to the arkypallidal neuron is based on location (GPe), expression of GAD1/2, FOXP2, MEIS2, and NPAS1 and lack of expression of canonical pallidal markers NKX2-1 and LHX6, SST and PV.</CAS:rationale>
    <CAS:rationale_dois>https://doi.org/10.1016/j.neuron.2015.03.007</CAS:rationale_dois>
    <CAS:rationale_dois>https://doi.org/10.1523/JNEUROSCI.4662-14.2015</CAS:rationale_dois>
    <CAS:rationale_dois>https://doi.org/10.1038/s41593-023-01368-7</CAS:rationale_dois>
    <CAS:marker_gene_evidence>GAD1</CAS:marker_gene_evidence>
    <CAS:marker_gene_evidence>GAD2</CAS:marker_gene_evidence>
    <CAS:marker_gene_evidence>FOXP2</CAS:marker_gene_evidence>
