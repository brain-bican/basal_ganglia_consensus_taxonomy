  <rdf:Description rdf:about="CS20250428_GROUP_0024">
    <CAS:has_labelset rdf:resource="Group"/>
    <rdfs:label>OT D1 ICj</rdfs:label>
    <CAS:cell_ontology_term>Islands of Calleja granule cell</CAS:cell_ontology_term>
    <CAS:rationale>Mapping to the general type VIP GABAergic neuron is supported by MapMyCells heirarchical annotation transfer mapping to 060 OT D3 Folh1 Gaba in the whole mouse brain taxonomy v1.</CAS:rationale>
    <CAS:rationale_dois>https://doi.org/10.1016/j.cub.2021.10.015</CAS:rationale_dois>
    <CAS:marker_gene_evidence>DRD1</CAS:marker_gene_evidence>
    <CAS:marker_gene_evidence>CPNE4</CAS:marker_gene_evidence>
    <CAS:synonyms>D1-ICj (Islands of Calleja)</CAS:synonyms>
