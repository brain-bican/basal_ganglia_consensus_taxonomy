  <rdf:Description rdf:about="CS20250428_GROUP_0047">
    <CAS:has_labelset rdf:resource="Group"/>
    <rdfs:label>VIP GABA</rdfs:label>
    <CAS:cell_ontology_term>VIP GABAergic interneuron</CAS:cell_ontology_term>
    <CAS:rationale>Mapping to the general type VIP GABAergic neuron is supported by MapMyCells heirarchical annotation transfer mapping to 046 Vip Gaba in the whole mouse brain taxonomy v1.</CAS:rationale>
    <CAS:rationale_dois>https://doi.org/10.1038/s41586-020-2874-8</CAS:rationale_dois>
